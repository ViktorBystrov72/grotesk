APP_NAME=grotesk-app
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_ECHO=false

POSTGRES_DB=grotesk
POSTGRES_USER=grotesk
POSTGRES_PASSWORD=

RABBITMQ_DEFAULT_USER=grotesk
RABBITMQ_DEFAULT_PASS=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://grotesk:@rabbitmq:5672/
RABBITMQ_QUEUE_NAME=ml_tasks
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_DURABLE_QUEUE=true
MESSAGING_BACKEND=rabbitmq
WORKER_ID=worker-1
WORKER_PROCESSING_DELAY_SECONDS=0.5
MEDIA_STORAGE_ROOT=/media
RESULT_ARTIFACT_ROOT=/media/results
HF_DEVICE=cuda
HF_AUDIO_MODEL_ID=openai/whisper-large-v3-turbo
HF_SPEAKER_MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
HF_VIDEO_MODEL_ID=decart-ai/Lucy-Edit-Dev
HF_VIDEO_WIDTH=832
HF_VIDEO_HEIGHT=480
HF_VIDEO_FPS=24
HF_VIDEO_MAX_FRAMES=81
HF_VIDEO_GUIDANCE_SCALE=5.0
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
